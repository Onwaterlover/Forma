# Copy to .env.local and adjust. Nothing here is required to run the app.

# Display name of the app (rename freely).
NEXT_PUBLIC_APP_NAME=Forma

# Cloud database (Supabase → Connect → Transaction pooler, port 6543). Leave empty to use the
# embedded local database in DATA_DIR instead.
DATABASE_URL=

# Local database folder (used only when DATABASE_URL is empty).
DATA_DIR=./data

# Contact sent in the User-Agent to Open Food Facts (their API terms ask for it).
OFF_CONTACT=change-me@example.com

# Set to "true" when the app is served over HTTPS (e.g. Tailscale serve) so cookies are marked Secure.
COOKIE_SECURE=false

# Exact hostnames allowed to submit forms through a reverse proxy, comma-separated.
# With Tailscale: your machine's address, e.g. ALLOWED_ORIGINS=my-pc.tail1234.ts.net
ALLOWED_ORIGINS=

# Optional AI assistant. Leave empty for no-AI mode; all core features work without it.
# Free option: Google Gemini (used when set). Key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Paid option: Claude (used when GEMINI_API_KEY is empty).
# Key from https://console.anthropic.com (API Keys). Server-side only, never shown to the browser.
ANTHROPIC_API_KEY=
# Optional: model id. Default claude-opus-5-5; claude-haiku-5-5 is much cheaper.
AI_MODEL=
